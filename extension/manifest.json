{
  "manifest_version": 3,
  "name": "Reading List MCP",
  "version": "0.1.0",
  "description": "Lets your AI assistant (Claude, Cursor, ...) read and organize your Chrome reading list through a local MCP server.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": [
    "readingList",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Reading List MCP"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
